{
  "id": "strombom_noise",
  "name": "Strombom Noise",
  "paper_title": "Solving the shepherding problem (noise variant)",
  "authors": "D. Strombom et al. (base); HerdSim noise preset variant",
  "year": 2014,
  "doi": "https://doi.org/10.1098/rsif.2014.0719",
  "mechanism": "Identical Collect/Drive logic with elevated sheep noise (and lower inertia) to test robustness under perturbation.",
  "agent_types": [
    "sheep",
    "shepherd"
  ],
  "herder_kind": "human",
  "herder_label": "Shepherd",
  "default_agents": {
    "sheep": 50,
    "shepherds": 1
  },
  "overlays": {
    "assignment_modes": [
      {
        "id": "collect",
        "label": "Collect: herder to outlier sheep being gathered.",
        "color": "#fbbf24"
      },
      {
        "id": "drive",
        "label": "Drive: herder to stand-off behind the flock.",
        "color": "#67e8f9"
      }
    ]
  },
  "param_groups": [
    {
      "id": "sheep",
      "label": "Sheep",
      "keys": [
        "r_a",
        "r_s",
        "rs_weight",
        "n_neighbors",
        "c",
        "noise_strength",
        "sheep_speed",
        "inertia",
        "graze_move_prob"
      ]
    },
    {
      "id": "shepherd",
      "label": "Shepherd",
      "keys": [
        "shepherd_speed",
        "shepherd_stop_multiple",
        "collect_threshold_scale"
      ]
    },
    {
      "id": "agents",
      "label": "Agents",
      "keys": [
        "n_sheep",
        "n_shepherds"
      ]
    }
  ]
}
