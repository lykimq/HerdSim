{
  "id": "obstacle_aware",
  "name": "Obstacle-Aware",
  "paper_title": "Obstacle / gate-aware Collect-Drive (Strombom base)",
  "authors": "HerdSim rule-based heuristic",
  "year": 2026,
  "mechanism": "Strombom Collect/Drive with an obstacle-aware Drive point: when the GCM-to-goal line intersects an obstacle, Pd is deflected around the nearer edge or aimed through a narrow-gate gap when wall pairs form a choke point.",
  "agent_types": ["sheep", "shepherd"],
  "herder_kind": "human",
  "herder_label": "Shepherd",
  "default_agents": {"sheep": 50, "shepherds": 1},
  "param_groups": [
    {
      "id": "sheep",
      "label": "Sheep",
      "keys": ["r_a", "r_s", "rs_weight", "n_neighbors", "c", "noise_strength", "sheep_speed", "inertia", "graze_move_prob"]
    },
    {
      "id": "shepherd",
      "label": "Shepherd",
      "keys": ["shepherd_speed", "shepherd_stop_multiple", "collect_threshold_scale", "obstacle_clearance"]
    },
    {
      "id": "agents",
      "label": "Agents",
      "keys": ["n_sheep", "n_shepherds"]
    }
  ],
  "overlays": {
    "assignment_modes": [
      {
        "id": "collect",
        "label": "Collect: herder to outlier sheep being gathered.",
        "color": "#fbbf24"
      },
      {
        "id": "drive",
        "label": "Drive: herder to obstacle-aware stand-off behind the flock.",
        "color": "#67e8f9"
      }
    ]
  }
}
