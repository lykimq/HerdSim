# Shepherding-budget campaigns: run protocol grids under results/budget/.
# Invoke: make budget-help  or  make -f Makefile.budget help

.PHONY: help budget-help budget-test budget-pilot budget-pilot-state \
	budget-analyse budget-scout budget-factor-sweep

UV ?= uv
export PYTHONPATH := $(CURDIR)$(if $(PYTHONPATH),:$(PYTHONPATH),)

# Campaign subsets (frozen protocol subsets).
BUDGET_CAMPAIGN_DIR ?= configs/budget/campaigns
PHASE1_PILOT_CAMPAIGN ?= $(BUDGET_CAMPAIGN_DIR)/phase1_pilot.yaml
PHASE1_SCOUT_CAMPAIGN ?= $(BUDGET_CAMPAIGN_DIR)/phase1_scout.yaml
PHASE2_STATE_CAMPAIGN ?= $(BUDGET_CAMPAIGN_DIR)/phase2_pilot_state.yaml
PHASE5_SWEEP_CAMPAIGN ?= $(BUDGET_CAMPAIGN_DIR)/phase5_factor_sweep.yaml

BUDGET_OUT ?= results/budget/phase1/pilot
STATE_OUT ?= results/budget/phase2/pilot_state
SCOUT_OUT ?= results/budget/phase1/scout
SWEEP_OUT ?= results/budget/phase5/factor_sweep

WORKERS ?= 1
BUDGET_MAX_TICKS ?=
PACKAGE ?= A
TRIALS ?= $(BUDGET_OUT)/trials.csv
OUT ?= $(BUDGET_OUT)/packages/$(shell echo $(PACKAGE) | tr A-Z a-z)

# Optional CLI overrides for ad-hoc grids.
BUDGET_INSTRUMENT ?=
BUDGET_LAYOUT ?=
BUDGET_N ?=
BUDGET_D ?=
BUDGET_SEEDS ?=

BUDGET_MAX_TICKS_FLAG = $(if $(BUDGET_MAX_TICKS),--max-ticks $(BUDGET_MAX_TICKS),)
BUDGET_OVERRIDE_FLAGS = \
	$(if $(BUDGET_INSTRUMENT),--instruments $(BUDGET_INSTRUMENT),) \
	$(if $(BUDGET_LAYOUT),--layouts $(BUDGET_LAYOUT),) \
	$(if $(BUDGET_N),--n $(BUDGET_N),) \
	$(if $(BUDGET_D),--d $(BUDGET_D),) \
	$(if $(BUDGET_SEEDS),--seeds $(BUDGET_SEEDS),)

.DEFAULT_GOAL := help

help budget-help:
	@echo "HerdSim -- shepherding-budget campaigns"
	@echo ""
	@echo "What this is:"
	@echo "  Batch simulations that ask: for flock size N sheep and D dogs,"
	@echo "  how often does herding succeed? Each target runs many (N, D)"
	@echo "  combinations and writes results under results/budget/."
	@echo "  Interrupted runs resume if you keep manifest.jsonl and"
	@echo "  re-run the same target."
	@echo ""
	@echo "Targets (grids match configs/budget/campaigns/*.yaml):"
	@echo "  help                 Show this help"
	@echo "  budget-test          Pytest for the budget runner and analysis code"
	@echo ""
	@echo "  budget-pilot         First run to try. Small grid so you can check the"
	@echo "                       tooling works (about 90 trials; usually minutes)."
	@echo "                       Sheep N in {25,50,100}, dogs D in {1,2,3,4,6,10},"
	@echo "                       5 random seeds, one layout (compact)."
	@echo "                       Output: results/budget/phase1/pilot/"
	@echo ""
	@echo "  budget-scout         Same question as pilot, but denser and more seeds"
	@echo "                       so you can see where success rises/falls with N and D"
	@echo "                       (about 1440 trials; often hours). N up to 200,"
	@echo "                       D up to 20, 30 seeds."
	@echo "                       Output: results/budget/phase1/scout/"
	@echo ""
	@echo "  budget-pilot-state   Like pilot, but repeats the grid on four starting"
	@echo "                       flock shapes (compact, wide, split, outlier-rich)"
	@echo "                       to see if layout changes how many dogs you need"
	@echo "                       (about 360 trials)."
	@echo "                       Output: results/budget/phase2/pilot_state/"
	@echo ""
	@echo "  budget-factor-sweep  Varies dog sensing (bearing-only, local, global)"
	@echo "                       at N in {50,100}, D in {1..10}, 10 seeds"
	@echo "                       (about 360 trials). Asks if better sensing means"
	@echo "                       fewer dogs."
	@echo "                       Output: results/budget/phase5/factor_sweep/"
	@echo ""
	@echo "  budget-analyse       Re-run analysis on an existing trials.csv"
	@echo "                       (no new simulations). Example:"
	@echo "                       make budget-analyse PACKAGE=A \\"
	@echo "                         TRIALS=results/budget/phase1/pilot/trials.csv \\"
	@echo "                         OUT=results/budget/phase1/pilot/packages/a"
	@echo ""
	@echo "Variables:"
	@echo "  WORKERS=N            Run N trials in parallel (default: $(WORKERS))"
	@echo "  BUDGET_MAX_TICKS=N   Optional early stop per trial (useful for quick tests)"
	@echo "  PACKAGE TRIALS OUT   Inputs for budget-analyse only"
	@echo ""
	@echo "Example:  make budget-pilot WORKERS=4"
	@echo "Docs:     results/budget/README.md"

budget-test:
	$(UV) run pytest tests/backend/correctness/test_budget_stack.py -q

budget-pilot:
	@mkdir -p $(BUDGET_OUT)
	$(UV) run scripts/budget/run_grid.py \
		--campaign $(PHASE1_PILOT_CAMPAIGN) \
		--output $(BUDGET_OUT) \
		--workers $(WORKERS) \
		$(BUDGET_MAX_TICKS_FLAG) \
		$(BUDGET_OVERRIDE_FLAGS)
	$(MAKE) -f Makefile.budget budget-analyse \
		PACKAGE=A TRIALS=$(BUDGET_OUT)/trials.csv OUT=$(BUDGET_OUT)/packages/a

budget-pilot-state:
	@mkdir -p $(STATE_OUT)
	$(UV) run scripts/budget/run_grid.py \
		--campaign $(PHASE2_STATE_CAMPAIGN) \
		--output $(STATE_OUT) \
		--workers $(WORKERS) \
		$(BUDGET_MAX_TICKS_FLAG) \
		$(BUDGET_OVERRIDE_FLAGS)
	$(MAKE) -f Makefile.budget budget-analyse \
		PACKAGE=B TRIALS=$(STATE_OUT)/trials.csv OUT=$(STATE_OUT)/packages/b

budget-analyse:
	$(UV) run scripts/budget/analyse.py \
		--package $(PACKAGE) \
		--trials $(TRIALS) \
		--output $(OUT)

budget-scout:
	@echo "NOTE: budget-scout is long-running (many N x D x seeds cells)."
	@echo "Output: $(SCOUT_OUT)  campaign=$(PHASE1_SCOUT_CAMPAIGN)"
	@mkdir -p $(SCOUT_OUT)
	$(UV) run scripts/budget/run_grid.py \
		--campaign $(PHASE1_SCOUT_CAMPAIGN) \
		--output $(SCOUT_OUT) \
		--workers $(WORKERS) \
		$(BUDGET_MAX_TICKS_FLAG) \
		$(BUDGET_OVERRIDE_FLAGS)
	$(MAKE) -f Makefile.budget budget-analyse \
		PACKAGE=A TRIALS=$(SCOUT_OUT)/trials.csv OUT=$(SCOUT_OUT)/packages/a
	$(MAKE) -f Makefile.budget budget-analyse \
		PACKAGE=F TRIALS=$(SCOUT_OUT)/trials.csv OUT=$(SCOUT_OUT)/packages/f

budget-factor-sweep:
	@mkdir -p $(SWEEP_OUT)
	$(UV) run scripts/budget/run_factor_sweep.py \
		--campaign $(PHASE5_SWEEP_CAMPAIGN) \
		--output $(SWEEP_OUT) \
		--workers $(WORKERS)
	$(MAKE) -f Makefile.budget budget-analyse \
		PACKAGE=E TRIALS=$(SWEEP_OUT)/trials.csv OUT=$(SWEEP_OUT)/packages/e
